# ---------------------------------------------------------------------------
# Jobiest — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Required (validated at startup by lib/env.ts): the three Supabase values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SERVER ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Public app URL --------------------------------------------------------
# Canonical origin used for redirect URLs (e.g. Flutterwave return URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Encryption ------------------------------------------------------------
# 32+ char master key for AES-256-GCM encryption of stored provider keys.
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# --- Flutterwave payments (optional — billing 503s until set) ---------------
FLW_SECRET_KEY=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_SECRET_HASH=

# --- AI providers -----------------------------------------------------------
# Base URLs default to the public OpenRouter / Hugging Face endpoints.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# --- Job sources (optional — comma-separated board tokens) ------------------
# Defaults are built in (see lib/jobsources/boards.ts).
# JOB_SOURCE_GREENHOUSE_BOARDS=
# JOB_SOURCE_LEVER_BOARDS=
# JOB_SOURCE_ASHBY_BOARDS=

# --- Rate limiting (falls back to pass-through only while unset) ------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (optional — protects the scheduled ingestion route) --------------
# CRON_SECRET=

# --- Tally form webhook (optional) ------------------------------------------
# TALLY_WEBHOOK_SECRET=

# --- Automation (autonomous submission — OFF until explicitly approved) ------
# Kill switch: must be the exact string 'true' to enable autonomous submission.
# AUTOMATION_SUBMIT_ENABLED=
# Isolated browser worker base URL (Render). Until set, submissions STOP safely.
# BROWSER_WORKER_URL=
# Shared secret for the browser worker's /submit endpoint (fail-closed gate).
# Generate with: openssl rand -hex 32
# BROWSER_WORKER_SECRET=
