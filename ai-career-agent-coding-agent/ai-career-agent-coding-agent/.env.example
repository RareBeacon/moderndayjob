# ---------------------------------------------------------------------------
# Jobiest — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Required (validated at startup by lib/env.ts): the three Supabase values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SERVER ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Public app URL --------------------------------------------------------
# Canonical origin used for redirect URLs (e.g. Flutterwave return URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Encryption ------------------------------------------------------------
# 32+ char master key for AES-256-GCM encryption of stored provider keys.
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# --- Flutterwave payments (optional — billing 503s until set) ---------------
FLW_SECRET_KEY=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_SECRET_HASH=

# --- AI providers -----------------------------------------------------------
# Base URLs default to the public OpenRouter / Hugging Face endpoints.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# --- Job sources (optional — comma-separated board tokens) ------------------
# Defaults are built in (see lib/jobsources/boards.ts).
# JOB_SOURCE_GREENHOUSE_BOARDS=
# JOB_SOURCE_LEVER_BOARDS=
# JOB_SOURCE_ASHBY_BOARDS=

# --- Rate limiting (falls back to pass-through only while unset) ------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (optional — protects the scheduled ingestion route) --------------
# CRON_SECRET=

# --- Security digest (optional — daily audit-log summary email) ------------
# Recipient for the /api/cron/security-digest email. Digest is skipped while
# unset. Requires RESEND_API_KEY to actually deliver.
# ADMIN_ALERT_EMAIL=

# --- Tally form webhook (optional) ------------------------------------------
# TALLY_WEBHOOK_SECRET=

# --- Automation (autonomous submission — OFF until explicitly approved) ------
# Kill switch: must be the exact string 'true' to enable autonomous submission.
# AUTOMATION_SUBMIT_ENABLED=
# Isolated browser worker base URL (Render). Until set, submissions STOP safely.
# BROWSER_WORKER_URL=
# Shared secret for the browser worker's /submit endpoint (fail-closed gate).
# Generate with: openssl rand -hex 32
# BROWSER_WORKER_SECRET=

# --- Self-hosted API gateway (Oracle Always Free — workers/api) --------------
# Comma-separated customer API keys (one per tenant). Fail-closed: empty = deny all.
# API_KEYS=
# Requests per key per window (default 30).
# RATE_LIMIT_MAX=30
# Rate-limit window in milliseconds (default 60000).
# RATE_LIMIT_WINDOW_MS=60000

# --- Ollama-first AI (Oracle VM, self-hosted) -------------------------------
# Base URL of the secret-gated AI gateway in front of Ollama. Empty disables
# Ollama and the app falls back to user-stored credentials only.
# OLLAMA_BASE_URL=
# Strongest practical local model for resumes/ATS/matching.
# OLLAMA_MODEL=qwen2.5:7b
# Lighter local model for high-volume/simple tasks (tried after the strong one).
# OLLAMA_FALLBACK_MODEL=llama3.2:3b
# Shared secret for the AI gateway (same value as AI_GATEWAY_SECRET on the VM).
# OLLAMA_API_KEY=

# --- Resend transactional email ----------------------------------------------
# Resend API key (server only). Emails are skipped while unset.
# RESEND_API_KEY=
# Verified sending address/domain on Resend.
# RESEND_FROM=hello@jobiest.com

# --- Google Search Console OAuth (optional, SEO Mission Control) -------------
# Create an OAuth client in Google Cloud with redirect URI:
# https://jobiest.com/api/admin/seo/oauth/callback
# Never commit real values. Without these, the SEO dashboard shows setup pending.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://jobiest.com/api/admin/seo/oauth/callback
