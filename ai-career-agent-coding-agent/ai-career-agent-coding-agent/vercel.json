{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/radar",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/daily-pipeline",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/security-digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/security-scan",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/cron/seo",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/cron/first-win-email",
      "schedule": "0 9 * * *"
    }
  ]
}
