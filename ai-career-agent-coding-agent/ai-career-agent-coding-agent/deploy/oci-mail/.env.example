# Jobiest Self-Hosted Mail Server Environment Template (.env)
# Copy to /opt/jobiest-mail/.env (chmod 600) before running docker compose up -d

PRIMARY_DOMAIN=jobiest.com
MAIL_HOSTNAME=mail.jobiest.com
WEBMAIL_HOSTNAME=webmail.jobiest.com
MTA_STS_HOSTNAME=mta-sts.jobiest.com
ACME_EMAIL=admin@jobiest.com

# Stalwart Bootstrap Admin Credentials (replace before first boot; enroll TOTP 2FA immediately)
STALWART_ADMIN_USER=postmaster
STALWART_ADMIN_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# Outbound TLS Smarthost Relay ($0/month; bypasses OCI Free Tier outbound TCP 25 & PTR block)
# Recommended Primary ($0/mo, 300 emails/day = ~9,000/mo): Brevo SMTP
RELAY_HOST=smtp-relay.brevo.com
RELAY_PORT=587
RELAY_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
RELAY_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY

# Optional Secondary Relay ($0/mo, 100 emails/day = 3,000/mo): Resend SMTP
FALLBACK_RELAY_HOST=smtp.resend.com
FALLBACK_RELAY_PORT=465
FALLBACK_RELAY_USER=resend
FALLBACK_RELAY_PASSWORD=REPLACE_WITH_RESEND_API_KEY

# Encrypted Nightly Mailbox Backup (Always Free OCI Object Storage <= 20 GiB cap)
OCI_BACKUP_BUCKET=jobiest-gate2-vault
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_WITH_STRONG_BACKUP_PASSPHRASE
BACKUP_RETENTION_DAYS=14
