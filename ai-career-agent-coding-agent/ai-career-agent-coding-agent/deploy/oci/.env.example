# --- Required ---------------------------------------------------------------
# Shared secret between the web app (Vercel) and the worker here.
# Must be the SAME value as BROWSER_WORKER_SECRET in Vercel.
BROWSER_WORKER_SECRET=

# Comma-separated API keys for the gateway (one per tenant). No spaces.
API_KEYS=

# DNS names pointing at this VM (Caddy provisions TLS automatically).
WORKER_DOMAIN=worker.jobiest.com
API_DOMAIN=api.jobiest.com

# --- Optional (defaults shown) ---------------------------------------------
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
